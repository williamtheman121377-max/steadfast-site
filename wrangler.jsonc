{
  // Cloudflare Worker settings for the STEADFAST site
  "name": "steadfast",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    // the website files
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
  // STRIPE_SECRET_KEY is NOT stored here. Add it as a secret:
  //   npx wrangler secret put STRIPE_SECRET_KEY
}
